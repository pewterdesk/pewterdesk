# Copy to .env and adjust as needed. Never commit .env (it's already in the
# root .gitignore).
#
# IMPORTANT: this file is for non-secret config only — endpoint overrides,
# feature flags, network selection. It is NOT where API keys or signing keys
# go, ever. Those come from the OS keychain via the Tauri app layer (see
# CLAUDE.md's security-sensitive-code section). A .env value ends up bundled
# into client-side JS in a Vite app, so anything placed here is effectively
# public.

# Hyperliquid REST/WS endpoints. Leave unset to use mainnet (the adapter's
# default) — set these to point at testnet during development.
VITE_HYPERLIQUID_REST_URL=https://api.hyperliquid.xyz
VITE_HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
